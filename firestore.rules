rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Booklet metadata: anyone can read (public viewer links), only an
    // admin (authorized via the Firebase Auth custom claim `admin: true`,
    // granted exclusively through the addAdminClaim Cloud Function) can
    // write.
    match /booklets/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Mirror of who currently holds the admin claim, written only by the
    // addAdminClaim/removeAdminClaim Cloud Functions (which run with
    // Admin SDK privileges and bypass these rules). Readable by admins so
    // the admin panel can list current admins; not writable directly by
    // any client, since custom claims — not this collection — are the
    // actual source of authorization.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
