rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Booklet metadata: anyone can read (public viewer links), only an
    // authenticated admin can create/update/delete.
    match /booklets/{slug} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
