rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Booklet metadata is public for viewer links. Writes require an explicit
    // custom admin claim; a normal authenticated account is not sufficient.
    match /booklets/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
