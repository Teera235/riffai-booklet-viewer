# Copy this file to .env.local and fill in values from the Firebase Console
# (Project Settings > General > Your apps > SDK setup and configuration).
# These are client-side identifiers, safe to expose in the built bundle —
# actual access control is enforced by Firestore/Storage Security Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
