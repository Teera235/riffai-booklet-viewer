rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Booklet PDFs are public for viewer links. Writes require an explicit
    // custom admin claim. Cap uploads at 250MB and require the PDF content
    // type to avoid arbitrary file hosting.
    match /booklets/{slug}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
