rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Booklet PDFs: anyone can read (public viewer links), only an
    // authenticated admin can upload/delete. Cap uploads at 250MB and
    // require the PDF content type to avoid arbitrary file hosting.
    match /booklets/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
